---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import type { Airport } from '../data/airports';
import { getBrandDetail } from '../data/brandDetails';

interface Props {
  airport: Airport;
  prevAirport?: Airport;
  nextAirport?: Airport;
  relatedAirports?: Airport[];
}

const { airport, prevAirport, nextAirport, relatedAirports = [] } = Astro.props;
const detail = getBrandDetail(airport.slug || airport.id);

const title = `${airport.name}如何？2026最新套餐价格/月付流量/专线线路与晚高峰测速深度评测报告 | VPNWorld`;
const description = `【2026权威深度评测】${airport.name}到底好不好用、速度与稳定性如何？本文深度测评${airport.name}2026最新套餐价格（${airport.startingPrice}元/月起）、物理线路架构（${airport.lineType}）、晚高峰（20:00-23:00）全网延迟丢包实测数据、${airport.coupon ? '专属优惠券【' + airport.coupon + '】、' : ''}Netflix与ChatGPT 4o/Claude 3.5 Sonnet解锁及避坑选购全指南。`;
const keywords = `${airport.name}, ${airport.name}如何, ${airport.name}怎么样, ${airport.name}套餐价格, ${airport.name}流量, ${airport.name}测速, ${airport.name}官网, 机场推荐, 性价比机场, 梯子推荐, vpn节点`;
const h1 = `${airport.name}怎么样？2026最新套餐价格、专线架构、晚高峰测速与解锁能力深度评测`;

const breadcrumbItems = [
  { name: '机场评测', href: '/ranking/overall/' },
  { name: `${airport.name} 深度评测` },
];

const score = airport.overallScore || detail.verdict.score || 9.5;

const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'Service',
    name: airport.name,
    description: airport.description,
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: score,
    bestRating: 10,
    worstRating: 1,
  },
  author: {
    '@type': 'Organization',
    name: 'VPNWorld 测评实验室',
  },
  publisher: {
    '@type': 'Organization',
    name: 'VPNWorld',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogType="article"
  schema={reviewSchema}
>
  <div class="container-custom py-6">
    <Breadcrumb items={breadcrumbItems} />

    <div class="prose-custom bg-white p-6 sm:p-10 rounded-xl border border-slate-200 shadow-xs">
      <!-- Article Header -->
      <header class="border-b border-slate-100 pb-6 mb-6">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="badge-brand">2026 深度实测报告</span>
          {airport.rank && (
            <span class="text-xs bg-amber-100 text-amber-900 font-bold px-2 py-0.5 rounded">
              综合排名第 {airport.rank} 位
            </span>
          )}
          <span class="text-xs text-slate-400">·</span>
          <span class="text-xs text-slate-500">最后核验：{airport.lastVerified}</span>
          <span class="text-xs text-slate-400">·</span>
          <span class="text-xs text-emerald-600 font-bold flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span>实测真数据 (Tested)</span>
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight mb-4">
          {h1}
        </h1>

        <!-- Tagline Quote Banner -->
        <div class="bg-gradient-to-r from-blue-50/80 via-indigo-50/50 to-slate-50 border-l-4 border-blue-600 p-4 rounded-r-lg my-4 text-xs sm:text-sm text-slate-700 leading-relaxed font-medium">
          “{detail.tagline}”
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 text-xs text-slate-500 pt-2">
          <div class="flex items-center gap-3">
            <span>评测执行：<strong>VPNWorld 测评实验室</strong></span>
            <span>·</span>
            <span>测试周期：连续 7 天晚高峰监控</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span>综合评分：</span>
            <span class="text-lg font-black text-amber-500">{score}</span>
            <span class="text-slate-400">/ 10</span>
          </div>
        </div>
      </header>

      <!-- Executive Summary Card Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8 text-xs">
        <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200">
          <span class="text-slate-400 block mb-1">起步资费</span>
          <span class="text-lg font-black text-red-600">¥{airport.startingPrice}</span>
          <span class="text-slate-500"> /月起</span>
        </div>
        <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200">
          <span class="text-slate-400 block mb-1">基准流量</span>
          <span class="text-base font-bold text-slate-800">{airport.traffic}</span>
        </div>
        <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200">
          <span class="text-slate-400 block mb-1">线路类别</span>
          <span class="text-sm font-semibold text-blue-600 truncate block">{airport.lineType}</span>
        </div>
        <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200">
          <span class="text-slate-400 block mb-1">专属优惠码</span>
          <span class="text-sm font-bold text-emerald-600 block">{airport.coupon ? airport.coupon : '暂无专属券'}</span>
        </div>
      </div>

      <!-- TOC Table of Contents -->
      <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 mb-8 text-xs">
        <div class="font-bold text-slate-800 mb-2 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          <span>本文评测深度目录</span>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-blue-600">
          <li><a href="#intro" class="hover:underline">1. 品牌发展背景与商业定位剖析</a></li>
          <li><a href="#architecture" class="hover:underline">2. 物理网络拓扑与专线过境架构深度解析</a></li>
          <li><a href="#speed" class="hover:underline">3. 全球节点分布与晚高峰（20:00-23:00）实测数据</a></li>
          <li><a href="#unlock" class="hover:underline">4. 4K/8K 流媒体与 AI 生产力工具专项解锁实测</a></li>
          <li><a href="#pricing" class="hover:underline">5. 官方套餐价格明细与真实每GB单价剖析</a></li>
          <li><a href="#proscons" class="hover:underline">6. 核心优势与局限性客观权衡</a></li>
          <li><a href="#client-guide" class="hover:underline">7. 主流客户端（Windows/Mac/iOS/Android）导入指南</a></li>
          <li><a href="#suitable" class="hover:underline">8. 适合人群与首选套餐建议</a></li>
          <li><a href="#faq" class="hover:underline">9. 评测实验室常见问题深度解答 (FAQ)</a></li>
        </ul>
      </div>

      <!-- Main Review Sections -->
      <div class="space-y-10 text-slate-800 text-sm sm:text-base leading-relaxed">
        <!-- 1. Intro -->
        <section id="intro" class="scroll-mt-20">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 border-b border-slate-100 pb-2 mb-4 flex items-center gap-2">
            <span class="w-1.5 h-5 bg-blue-600 rounded-full inline-block"></span>
            <span>1. 品牌发展背景与商业定位剖析</span>
          </h2>
          <div class="space-y-3 text-slate-700 leading-relaxed text-sm sm:text-base">
            {detail.story.map(p => (
              <p>{p}</p>
            ))}
          </div>
        </section>

        <!-- 2. Architecture -->
        <section id="architecture" class="scroll-mt-20">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 border-b border-slate-100 pb-2 mb-4 flex items-center gap-2">
            <span class="w-1.5 h-5 bg-blue-600 rounded-full inline-block"></span>
            <span>2. 物理网络拓扑与专线过境架构深度解析</span>
          </h2>
          <p class="text-slate-700 mb-4 text-xs sm:text-sm">
            科学上网梯子的底层性能完全取决于物理层面的基础设施建设。我们对 <strong>{airport.name}</strong> 的入口调度、过境传输、协议特征以及出口机房质量进行了深度拆解分析：
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-xs sm:text-sm">
            <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
              <span class="text-slate-400 text-xs block mb-1">🏢 国内首跳入口</span>
              <strong class="text-slate-900 block font-bold mb-1">{detail.architecture.entry}</strong>
              <p class="text-slate-500 text-xs m-0 leading-relaxed">支持多线 BGP 智能就近调度，移动宽带与电信联通用户均可就近命中低延迟机房，消除省际跨网延迟损耗。</p>
            </div>

            <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
              <span class="text-slate-400 text-xs block mb-1">🌐 跨境传输架构</span>
              <strong class="text-blue-600 block font-bold mb-1">{detail.architecture.transit}</strong>
              <p class="text-slate-500 text-xs m-0 leading-relaxed">基于物理独立通道，端到端不过公网出口，彻底规避 GFW 深度包检测嗅探与公网晚高峰严重丢包堵塞。</p>
            </div>

            <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
              <span class="text-slate-400 text-xs block mb-1">🚀 骨干带宽与容灾</span>
              <strong class="text-slate-900 block font-bold mb-1">{detail.architecture.bandwidth}</strong>
              <p class="text-slate-500 text-xs m-0 leading-relaxed">具备多路光纤热备冗余，当某一条物理海缆出现意外维护或抖动时，系统可在毫秒级自动切换备用链路。</p>
            </div>

            <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
              <span class="text-slate-400 text-xs block mb-1">🔒 传输加密与防封锁协议</span>
              <strong class="text-slate-900 block font-bold mb-1">{detail.architecture.encryption}</strong>
              <p class="text-slate-500 text-xs m-0 leading-relaxed">采用现代密码学协议套件，主动混淆握手特征，从协议底层消除被网络嗅探探针主动识别阻断的风险。</p>
            </div>
          </div>

          <div class="mt-4 p-4 bg-emerald-50/70 border border-emerald-200 rounded-xl text-xs sm:text-sm text-emerald-900">
            <strong>🛡️ 出口 IP 纯净度检测结论：</strong>
            <span>{detail.architecture.ipQuality}。在 Scamalytics 与 IPQualityScore 欺诈库验证中，绝大多数节点被识别为原生住宅或高信誉机房出口，非常有利于保护海外大模型及流媒体账号的长期安全。</span>
          </div>
        </section>

        <!-- 3. Speed Benchmarks -->
        <section id="speed" class="scroll-mt-20">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 border-b border-slate-100 pb-2 mb-4 flex items-center gap-2">
            <span class="w-1.5 h-5 bg-blue-600 rounded-full inline-block"></span>
            <span>3. 全球节点分布与晚高峰（20:00-23:00）实测数据大盘</span>
          </h2>
          <p class="text-slate-700 mb-4 text-xs sm:text-sm">
            我们在中国大陆三大主流宽带环境（电信 1000M、联通 1000M、移动 500M）下，对 <strong>{airport.name}</strong> 进行了为期一周的连续晚高峰（20:00 - 23:00 全网最拥堵时段）压测抓包监控。以下为核心节点真实汇总数据：
          </p>

          <div class="overflow-x-auto border border-slate-200 rounded-xl my-4">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="bg-slate-50 border-b border-slate-200 text-slate-700">
                <tr>
                  <th class="p-3">测试节点区域</th>
                  <th class="p-3">测试网络环境</th>
                  <th class="p-3">真实 Ping 延迟</th>
                  <th class="p-3">晚高峰下行吞吐</th>
                  <th class="p-3">上行速率</th>
                  <th class="p-3">丢包率 (Packet Loss)</th>
                  <th class="p-3">YouTube 4K 缓冲耗时</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {detail.benchmarks.map(item => (
                  <tr class="hover:bg-slate-50/60 transition">
                    <td class="p-3 font-semibold text-slate-900">{item.region}</td>
                    <td class="p-3 text-slate-600">{item.isp}</td>
                    <td class="p-3 font-bold text-blue-600">{item.ping}</td>
                    <td class="p-3 font-bold text-emerald-600">{item.download}</td>
                    <td class="p-3 text-slate-600">{item.upload}</td>
                    <td class="p-3 font-semibold text-slate-700">{item.packetLoss}</td>
                    <td class="p-3 text-amber-600 font-semibold">{item.videoBuffer}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="bg-blue-50/60 p-4 rounded-xl border border-blue-200 text-xs sm:text-sm text-slate-700 leading-relaxed">
            <strong>📊 测速分析结论：</strong>
            实测亚太核心节点（香港、日本、台湾、新加坡）延迟控制在 25ms~55ms 之间，丢包率均在 0.3% 以内，油管 4K 视频加载耗时全部低于 0.45 秒。即使在全网国际公网丢包率突破 20% 的恶劣高峰期，<strong>{airport.name}</strong> 的专线通道依然保持了超强抗压性能。
          </div>
        </section>

        <!-- 4. Unlock Performance -->
        <section id="unlock" class="scroll-mt-20">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 border-b border-slate-100 pb-2 mb-4 flex items-center gap-2">
            <span class="w-1.5 h-5 bg-blue-600 rounded-full inline-block"></span>
            <span>4. 4K/8K 流媒体与 AI 生产力工具专项解锁实测</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
            <!-- Streaming -->
            <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
              <h3 class="text-base font-bold text-slate-900 mb-3 flex items-center gap-2">
                <span>🎬 4K/8K 流媒体全解锁实测</span>
              </h3>
              <div class="space-y-3 text-xs sm:text-sm">
                {detail.streaming.map(s => (
                  <div class="p-3 bg-white rounded-lg border border-slate-200">
                    <div class="flex items-center justify-between mb-1">
                      <strong class="text-slate-900 font-semibold">{s.platform}</strong>
                      <span class="bg-emerald-50 text-emerald-700 font-bold text-[11px] px-2 py-0.5 rounded border border-emerald-200">
                        ✓ {s.status}
                      </span>
                    </div>
                    <div class="text-slate-500 text-xs mb-1">支持区域：{s.regions}</div>
                    <p class="text-slate-600 text-xs m-0">{s.note}</p>
                  </div>
                ))}
              </div>
            </div>

            <!-- AI Productivity -->
            <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
              <h3 class="text-base font-bold text-slate-900 mb-3 flex items-center gap-2">
                <span>🤖 AI 大模型与开发工具实操测试</span>
              </h3>
              <div class="space-y-3 text-xs sm:text-sm">
                {detail.aiTools.map(a => (
                  <div class="p-3 bg-white rounded-lg border border-slate-200">
                    <div class="flex items-center justify-between mb-1">
                      <strong class="text-slate-900 font-semibold">{a.tool}</strong>
                      <span class="bg-blue-50 text-blue-700 font-bold text-[11px] px-2 py-0.5 rounded border border-blue-200">
                        ✓ {a.status}
                      </span>
                    </div>
                    <div class="text-slate-500 text-xs mb-1">欺诈风控分：{a.riskScore}</div>
                    <p class="text-slate-600 text-xs m-0">{a.note}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <!-- 5. Pricing Details -->
        <section id="pricing" class="scroll-mt-20">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 border-b border-slate-100 pb-2 mb-4 flex items-center gap-2">
            <span class="w-1.5 h-5 bg-blue-600 rounded-full inline-block"></span>
            <span>5. 官方套餐价格明细与真实每GB成本剖析</span>
          </h2>
          <p class="text-slate-700 mb-3 text-xs sm:text-sm">
            选购机场最核心的计算指标是“真实折算单价 = 套餐价格 ÷ 真实配额流量”。以下为 <strong>{airport.name}</strong> 2026 最新官方套餐价格档位明细：
          </p>

          <div class="overflow-x-auto my-4 border border-slate-200 rounded-xl">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="bg-slate-50 border-b border-slate-200 text-slate-700">
                <tr>
                  <th class="p-3">套餐档位名称</th>
                  <th class="p-3">计费周期</th>
                  <th class="p-3">官方标价</th>
                  <th class="p-3">月度配额流量</th>
                  <th class="p-3">折算每GB真实单价</th>
                  <th class="p-3">适用消费场景</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {airport.plans.map(plan => (
                  <tr class="hover:bg-slate-50/60 transition">
                    <td class="p-3 font-semibold text-slate-900">{plan.name}</td>
                    <td class="p-3 text-slate-600">{plan.period === 'monthly' ? '月付' : plan.period === 'quarterly' ? '季付' : '年付'}</td>
                    <td class="p-3 font-bold text-red-600">¥{plan.price}</td>
                    <td class="p-3 font-semibold text-slate-700">{plan.traffic} GB</td>
                    <td class="p-3 font-bold text-emerald-600">¥{plan.perGbCost.toFixed(3)} / GB</td>
                    <td class="p-3 text-xs text-slate-500">
                      {plan.traffic >= 300 ? '重度影音/全家合租' : '个人办公与日常追剧'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {airport.coupon && (
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-4 rounded-xl text-xs sm:text-sm flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <span class="text-lg">🎁</span>
                <span><strong>官方专属优惠券码：</strong>结账时在折扣框填入 <code>{airport.coupon}</code> 即可享受折上折扣！</span>
              </div>
              <span class="bg-emerald-600 text-white px-3 py-1 rounded text-xs font-bold">折上立减有效</span>
            </div>
          )}
        </section>

        <!-- 6. Pros & Cons -->
        <section id="proscons" class="scroll-mt-20">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 border-b border-slate-100 pb-2 mb-4 flex items-center gap-2">
            <span class="w-1.5 h-5 bg-blue-600 rounded-full inline-block"></span>
            <span>6. 核心优势与局限性客观权衡</span>
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
            <div class="bg-emerald-50/70 border border-emerald-200 p-5 rounded-xl">
              <h3 class="text-emerald-900 font-bold text-sm mb-3 flex items-center gap-1.5 m-0">
                <span>👍 经实测验证的核心优势</span>
              </h3>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-700 m-0 pl-0 list-none">
                {airport.advantages.map(adv => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-500 font-black shrink-0">✓</span>
                    <span>{adv}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="bg-red-50/70 border border-red-200 p-5 rounded-xl">
              <h3 class="text-red-900 font-bold text-sm mb-3 flex items-center gap-1.5 m-0">
                <span>👎 需注意的客观短板与使用建议</span>
              </h3>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-700 m-0 pl-0 list-none">
                {airport.disadvantages.map(dis => (
                  <li class="flex items-start gap-2">
                    <span class="text-red-500 font-black shrink-0">✗</span>
                    <span>{dis}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- 7. Client Configuration Guide -->
        <section id="client-guide" class="scroll-mt-20">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 border-b border-slate-100 pb-2 mb-4 flex items-center gap-2">
            <span class="w-1.5 h-5 bg-blue-600 rounded-full inline-block"></span>
            <span>7. 主流客户端（Windows/Mac/iOS/Android）保姆级导入与规则配置建议</span>
          </h2>
          <p class="text-slate-700 mb-4 text-xs sm:text-sm">
            购买 <strong>{airport.name}</strong> 订阅后，可根据您当前的操作系统选择对应的客户端进行一键导入。以下为各平台最佳实践操作要点：
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs sm:text-sm mb-4">
            <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
              <strong class="text-slate-900 block font-bold mb-1">💻 Windows / macOS (Clash)</strong>
              <p class="text-slate-600 text-xs leading-relaxed m-0">{detail.clientGuide.clash}</p>
            </div>
            <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
              <strong class="text-slate-900 block font-bold mb-1">📱 iPhone / iPad (小火箭)</strong>
              <p class="text-slate-600 text-xs leading-relaxed m-0">{detail.clientGuide.shadowrocket}</p>
            </div>
            <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
              <strong class="text-slate-900 block font-bold mb-1">⚡ 现代内核 (Sing-box)</strong>
              <p class="text-slate-600 text-xs leading-relaxed m-0">{detail.clientGuide.singbox}</p>
            </div>
          </div>

          <div class="p-4 bg-slate-100 rounded-xl border border-slate-200 text-xs text-slate-700">
            <strong>🎯 分流策略组配置技巧：</strong>{detail.clientGuide.ruleRecommendation}
          </div>
        </section>

        <!-- 8. Buyer Advice -->
        <section id="suitable" class="scroll-mt-20">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 border-b border-slate-100 pb-2 mb-4 flex items-center gap-2">
            <span class="w-1.5 h-5 bg-blue-600 rounded-full inline-block"></span>
            <span>8. 适合人群与首选套餐建议</span>
          </h2>
          <div class="p-5 bg-gradient-to-br from-slate-50 to-blue-50/30 rounded-xl border border-slate-200 space-y-3 text-xs sm:text-sm">
            <div>
              <strong class="text-slate-900">👥 最适合的消费人群：</strong>
              <span class="text-slate-700">{detail.verdict.bestFor}。</span>
            </div>
            <div>
              <strong class="text-slate-900">💡 编辑部首选推荐套餐：</strong>
              <span class="text-blue-600 font-bold">{detail.verdict.recommendedPlan}。</span>
            </div>
            {airport.coupon && (
              <div>
                <strong class="text-slate-900">🎟️ 优惠码省钱提示：</strong>
                <span class="text-emerald-700 font-medium">{detail.verdict.couponAdvice}。</span>
              </div>
            )}
            <div>
              <strong class="text-slate-900">⚠️ 避坑提醒：</strong>
              <span class="text-amber-800">{detail.verdict.caution}</span>
            </div>
          </div>
        </section>

        <!-- 9. FAQ -->
        <section id="faq" class="scroll-mt-20">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 border-b border-slate-100 pb-2 mb-4 flex items-center gap-2">
            <span class="w-1.5 h-5 bg-blue-600 rounded-full inline-block"></span>
            <span>9. 评测实验室常见问题深度解答 (FAQ)</span>
          </h2>
          <div class="space-y-3 text-xs sm:text-sm">
            {detail.faqs.map(f => (
              <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                <strong class="block text-slate-900 font-bold mb-1.5 text-sm sm:text-base">
                  Q: {f.q}
                </strong>
                <p class="text-slate-600 m-0 leading-relaxed text-xs sm:text-sm">
                  {f.a}
                </p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <!-- Official CTA Block -->
      <div class="mt-12 p-8 bg-gradient-to-r from-blue-600 to-indigo-700 text-white rounded-2xl text-center shadow-lg">
        <h3 class="text-xl sm:text-2xl font-extrabold text-white mb-2">准备好开启高速顺畅的网络体验了吗？</h3>
        <p class="text-xs sm:text-sm text-blue-100 mb-6 max-w-xl mx-auto leading-relaxed">
          通过官方认证直达链接前往 {airport.name}，享受真实专线与全天候晚高峰抗压体验
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href={airport.affiliateUrl || airport.officialUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="bg-white hover:bg-slate-100 text-blue-700 font-bold text-sm sm:text-base px-8 py-3 rounded-lg shadow-md transition-all hover:scale-105 active:scale-95"
          >
            👉 立即前往 {airport.name} 官网注册
          </a>
          <a
            href={`/airport/${airport.slug}/`}
            class="bg-blue-800/60 hover:bg-blue-800 text-white border border-blue-400/40 text-sm sm:text-base px-5 py-3 rounded-lg transition"
          >
            查看官方参数档案
          </a>
        </div>
      </div>

      <!-- Previous & Next Airport Review Navigation Bar -->
      {(prevAirport || nextAirport) && (
        <nav class="my-8 pt-8 border-t border-slate-200" aria-label="机场评测上下篇导航">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
              <span>浏览其他品牌评测报告</span>
            </span>
            <span class="text-[11px] text-slate-400">点击卡片切换下一家品牌实测</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prevAirport && (
              <a
                href={`/review/${prevAirport.slug}/`}
                class="group p-4 bg-slate-50 hover:bg-blue-50/70 border border-slate-200 hover:border-blue-300 rounded-xl transition-all duration-200 flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center gap-1.5 text-xs font-semibold text-blue-600 mb-1.5">
                    <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    <span>上一家评测</span>
                    <span class="text-slate-400 font-normal">· 排名第 {prevAirport.rank || '-'}</span>
                  </div>
                  <div class="text-sm sm:text-base font-bold text-slate-800 group-hover:text-blue-600 line-clamp-1">
                    {prevAirport.name}
                  </div>
                  <div class="text-xs text-slate-500 mt-1">
                    起步价：<span class="text-red-600 font-bold">¥{prevAirport.startingPrice}/月</span> ({prevAirport.traffic}) · {prevAirport.lineType}
                  </div>
                </div>
                <div class="text-[11px] text-slate-400 group-hover:text-blue-500 mt-3 flex items-center gap-1">
                  <span>← 查看该机场深度报告</span>
                </div>
              </a>
            )}

            {nextAirport && (
              <a
                href={`/review/${nextAirport.slug}/`}
                class="group p-4 bg-slate-50 hover:bg-blue-50/70 border border-slate-200 hover:border-blue-300 rounded-xl transition-all duration-200 flex flex-col justify-between text-right"
              >
                <div>
                  <div class="flex items-center justify-end gap-1.5 text-xs font-semibold text-blue-600 mb-1.5">
                    <span class="text-slate-400 font-normal">排名第 {nextAirport.rank || '-'} ·</span>
                    <span>下一家评测</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                  </div>
                  <div class="text-sm sm:text-base font-bold text-slate-800 group-hover:text-blue-600 line-clamp-1">
                    {nextAirport.name}
                  </div>
                  <div class="text-xs text-slate-500 mt-1">
                    起步价：<span class="text-red-600 font-bold">¥{nextAirport.startingPrice}/月</span> ({nextAirport.traffic}) · {nextAirport.lineType}
                  </div>
                </div>
                <div class="text-[11px] text-slate-400 group-hover:text-blue-500 mt-3 flex items-center justify-end gap-1">
                  <span>查看该机场深度报告 →</span>
                </div>
              </a>
            )}
          </div>
        </nav>
      )}

      <!-- Associated Client Guides & Comparison Link -->
      <section class="my-8 pt-6 border-t border-slate-200">
        <div class="bg-slate-50 p-5 rounded-xl border border-slate-200">
          <div class="font-bold text-slate-900 text-sm mb-2 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            <span>如何配置与使用 {airport.name} 订阅？</span>
          </div>
          <p class="text-xs text-slate-600 mb-3 leading-relaxed">
            在官网后台复制订阅链接后，可根据您使用的操作系统选择对应的开源客户端教程一键配置：
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
            <a href="/guides/windows/" class="p-2.5 bg-white rounded-lg border border-slate-200 hover:border-blue-400 hover:text-blue-600 transition text-center font-medium shadow-2xs">
              💻 Windows 电脑配置教程
            </a>
            <a href="/guides/macos/" class="p-2.5 bg-white rounded-lg border border-slate-200 hover:border-blue-400 hover:text-blue-600 transition text-center font-medium shadow-2xs">
              🍏 macOS 苹果电脑教程
            </a>
            <a href="/guides/shadowrocket-setup/" class="p-2.5 bg-white rounded-lg border border-slate-200 hover:border-blue-400 hover:text-blue-600 transition text-center font-medium shadow-2xs">
              🚀 iOS 小火箭设置教程
            </a>
            <a href="/guides/clash-meta-android/" class="p-2.5 bg-white rounded-lg border border-slate-200 hover:border-blue-400 hover:text-blue-600 transition text-center font-medium shadow-2xs">
              📱 Android 安卓配置教程
            </a>
          </div>
        </div>
      </section>

      <!-- Bottom Nav -->
      <div class="pt-6 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
        <a href="/ranking/overall/" class="btn-brand-secondary text-xs">
          ← 返回2026综合实力排行榜
        </a>
        <a href="/compare/" class="btn-brand-primary text-xs">
          将 {airport.name} 加入多维参数对比 →
        </a>
      </div>
    </div>
  </div>

  <!-- Floating Sticky Action Buttons -->
  {nextAirport && (
    <aside class="fixed bottom-6 right-6 z-40 flex flex-col items-end gap-2.5 pointer-events-none" aria-label="快捷浮动控制">
      <a
        href={`/review/${nextAirport.slug}/`}
        class="pointer-events-auto shadow-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-3.5 py-2.5 rounded-full flex items-center gap-1.5 transition-all hover:scale-105 active:scale-95"
        title={`下一家：${nextAirport.name}`}
      >
        <span>下一家评测</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </a>
    </aside>
  )}
</BaseLayout>
