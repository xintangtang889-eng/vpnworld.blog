---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { name: '首页', href: '/' },
  { name: '机场推荐', href: '/recommend/budget/' },
  { name: '机场排行', href: '/ranking/overall/' },
  { name: '机场评测', href: '/review/breezenet/' },
  { name: '机场对比', href: '/compare/' },
  { name: '使用教程', href: '/guides/' },
  { name: '博客文章', href: '/blog/' },
];
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <div class="container-custom flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-1.5 font-bold text-xl text-slate-900 tracking-tight hover:opacity-90">
      <span class="bg-blue-600 text-white text-xs font-black px-1.5 py-0.5 rounded">VPN</span>
      <span>World</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-700">
      {navItems.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-md transition-colors ${
              isActive
                ? 'text-blue-600 font-semibold bg-blue-50'
                : 'hover:text-blue-600 hover:bg-slate-100'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions (Contact Us + Search + Mobile Toggle) -->
    <div class="flex items-center gap-2">
      <!-- Contact Us Interactive Dropdown (Positioned in the red box area) -->
      <div class="relative" id="contact-dropdown-wrapper">
        <button
          type="button"
          id="contact-btn"
          class="flex items-center gap-1.5 text-xs font-semibold text-blue-600 bg-blue-50/80 hover:bg-blue-100 border border-blue-200 hover:border-blue-300 px-3 py-1.5 rounded-full transition-all shadow-2xs hover:shadow-xs focus:outline-none"
          aria-expanded="false"
          aria-haspopup="true"
          title="联络我们与商务对接"
        >
          <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
          <span>联络我们</span>
          <svg class="w-3 h-3 text-blue-500 transition-transform duration-200" id="contact-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>

        <!-- Dropdown Modal Card -->
        <div
          id="contact-panel"
          class="hidden absolute right-0 top-full mt-2.5 w-80 sm:w-88 bg-white border border-slate-200 rounded-2xl shadow-xl p-4 z-50 text-slate-800"
        >
          <!-- Header -->
          <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
            <div>
              <div class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>商务合作 & 技术咨询</span>
              </div>
              <p class="text-[11px] text-slate-400 m-0 mt-0.5">官方唯一认证渠道 · 24小时内极速回复</p>
            </div>
            <button
              type="button"
              id="contact-close-btn"
              class="text-slate-400 hover:text-slate-600 p-1 rounded-md transition"
              aria-label="关闭联络卡片"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>

          <!-- Channel 1: Telegram (Recommended) -->
          <div class="bg-gradient-to-r from-sky-50 to-blue-50/70 p-3.5 rounded-xl border border-sky-100 mb-3">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-sky-500 text-white flex items-center justify-center shadow-xs">
                  <svg class="w-4.5 h-4.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.63 3.73-.53.37-1.02.55-1.45.54-.48-.01-1.4-.27-2.09-.49-.84-.27-1.51-.42-1.45-.89.03-.25.38-.51 1.07-.78 4.2-1.82 7-3.03 8.4-3.61 4-.1.67 1.83 1.13 2.5 1.34z"/></svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-900 flex items-center gap-1">
                    <span>Telegram 官方直通</span>
                    <span class="bg-sky-500 text-white text-[9px] px-1 py-0.2 rounded font-semibold">首选推荐</span>
                  </div>
                  <div class="text-xs text-sky-700 font-bold font-mono">@xintangtang</div>
                </div>
              </div>
              <a
                href="https://t.me/xintangtang"
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition-all shadow-xs hover:scale-105 active:scale-95 flex items-center gap-1"
              >
                <span>直接私聊</span>
                <span>→</span>
              </a>
            </div>
            <p class="text-[11px] text-slate-500 m-0 leading-relaxed">
              支持即时一对一沟通：机场收录与送测、商务推广洽谈、线路纠错及读者技术答疑。
            </p>
          </div>

          <!-- Channel 2: Gmail -->
          <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 mb-3">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-red-500 text-white flex items-center justify-center shadow-xs">
                  <svg class="w-4.5 h-4.5 fill-current" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                </div>
                <div class="overflow-hidden">
                  <div class="text-xs font-bold text-slate-900">官方电子邮箱</div>
                  <div class="text-xs text-slate-700 font-semibold font-mono truncate" id="gmail-address-display">xintangtang888@gmail.com</div>
                </div>
              </div>
              <button
                type="button"
                id="copy-email-btn"
                class="bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-medium px-2.5 py-1.5 rounded-lg transition shadow-2xs shrink-0 flex items-center gap-1"
                title="一键复制 Gmail 邮箱"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                <span id="copy-email-text">复制</span>
              </button>
            </div>
            <div class="flex items-center justify-between text-[11px] text-slate-500 pt-1 border-t border-slate-200/60">
              <span>适用于商业公函与详细送审材料</span>
              <a href="mailto:xintangtang888@gmail.com" class="text-blue-600 hover:underline font-semibold flex items-center gap-0.5">
                <span>唤起邮箱发送</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- Bottom Footer Note -->
          <div class="text-[10px] text-slate-400 text-center leading-relaxed pt-1">
            🤝 客观公正评测 · 诚信商务合作 · 欢迎各机场运营方与技术极客交流
          </div>
        </div>
      </div>

      <!-- Search Button -->
      <button
        type="button"
        id="search-btn"
        class="flex items-center gap-1.5 text-xs font-medium text-slate-500 bg-slate-100 hover:bg-slate-200 border border-slate-200 px-3 py-1.5 rounded-full transition"
        aria-label="搜索全站文章与机场"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <span>搜索</span>
        <kbd class="hidden sm:inline-block bg-white text-slate-400 text-[10px] px-1.5 py-0.2 rounded border border-slate-200">Ctrl K</kbd>
      </button>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden p-2 text-slate-600 hover:text-slate-900 focus:outline-none"
        aria-label="切换菜单"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white px-4 pt-2 pb-4 space-y-1">
    {navItems.map(item => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-blue-600 hover:bg-blue-50"
      >
        {item.name}
      </a>
    ))}

    <!-- Mobile Contact Quick Card -->
    <div class="mt-3 pt-3 border-t border-slate-100 p-3 bg-slate-50 rounded-xl space-y-2">
      <div class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>联络我们（商务合作 / 纠错反馈）</span>
      </div>
      <div class="grid grid-cols-2 gap-2 text-xs">
        <a
          href="https://t.me/xintangtang"
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="p-2 bg-sky-50 text-sky-700 border border-sky-200 rounded-lg font-bold text-center flex items-center justify-center gap-1"
        >
          <span>Telegram: @xintangtang</span>
        </a>
        <a
          href="mailto:xintangtang888@gmail.com"
          class="p-2 bg-white text-slate-700 border border-slate-200 rounded-lg font-medium text-center truncate"
        >
          <span>发邮件联系</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Contact dropdown modal toggle
  const contactBtn = document.getElementById('contact-btn');
  const contactPanel = document.getElementById('contact-panel');
  const contactArrow = document.getElementById('contact-arrow');
  const contactCloseBtn = document.getElementById('contact-close-btn');
  const contactWrapper = document.getElementById('contact-dropdown-wrapper');
  const copyEmailBtn = document.getElementById('copy-email-btn');
  const copyEmailText = document.getElementById('copy-email-text');

  function openContactPanel() {
    contactPanel?.classList.remove('hidden');
    contactArrow?.classList.add('rotate-180');
    contactBtn?.setAttribute('aria-expanded', 'true');
  }

  function closeContactPanel() {
    contactPanel?.classList.add('hidden');
    contactArrow?.classList.remove('rotate-180');
    contactBtn?.setAttribute('aria-expanded', 'false');
  }

  if (contactBtn && contactPanel) {
    contactBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = contactPanel.classList.contains('hidden');
      if (isHidden) {
        openContactPanel();
      } else {
        closeContactPanel();
      }
    });

    contactCloseBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeContactPanel();
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (contactWrapper && !contactWrapper.contains(e.target as Node)) {
        closeContactPanel();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeContactPanel();
      }
    });
  }

  // One-click copy Gmail
  if (copyEmailBtn && copyEmailText) {
    copyEmailBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const email = 'xintangtang888@gmail.com';
      try {
        await navigator.clipboard.writeText(email);
        copyEmailText.textContent = '已复制 ✓';
        copyEmailBtn.classList.add('text-emerald-600', 'border-emerald-300', 'bg-emerald-50');
        setTimeout(() => {
          copyEmailText.textContent = '复制';
          copyEmailBtn.classList.remove('text-emerald-600', 'border-emerald-300', 'bg-emerald-50');
        }, 2000);
      } catch (err) {
        // Fallback prompt if clipboard fails
        window.prompt('请手动复制 Gmail 邮箱：', email);
      }
    });
  }
</script>
