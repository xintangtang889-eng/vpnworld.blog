---
interface BreadcrumbItem {
  name: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="flex items-center text-xs text-slate-500 py-3 mb-4 overflow-x-auto whitespace-nowrap" aria-label="面包屑导航">
  <a href="/" class="hover:text-blue-600 transition flex items-center gap-1">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
    <span>首页</span>
  </a>

  {items.map((item, index) => {
    const isLast = index === items.length - 1;
    return (
      <div class="flex items-center">
        <span class="mx-2 text-slate-300">/</span>
        {isLast || !item.href ? (
          <span class="text-slate-800 font-medium truncate max-w-[240px] sm:max-w-none">{item.name}</span>
        ) : (
          <a href={item.href} class="hover:text-blue-600 transition truncate max-w-[180px] sm:max-w-none">
            {item.name}
          </a>
        )}
      </div>
    );
  })}
</nav>
