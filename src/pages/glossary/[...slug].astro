---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const terms = await getCollection('glossary');
  terms.sort((a, b) => a.slug.localeCompare(b.slug));

  return terms.map((entry, index) => {
    const prevTerm = index > 0 ? terms[index - 1] : terms[terms.length - 1];
    const nextTerm = index < terms.length - 1 ? terms[index + 1] : terms[0];

    return {
      params: { slug: entry.slug },
      props: { entry, prevTerm, nextTerm },
    };
  });
}

const { entry, prevTerm, nextTerm } = Astro.props;
const { Content } = await entry.render();

const breadcrumbItems = [
  { name: '术语百科', href: '/glossary/' },
  { name: entry.data.h1 },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
>
  <div class="container-custom py-6">
    <Breadcrumb items={breadcrumbItems} />

    <article class="prose-custom bg-white p-6 sm:p-10 rounded-xl border border-slate-200 shadow-xs">
      <header class="border-b border-slate-100 pb-6 mb-6">
        <span class="badge-brand mb-2">网络技术百科</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
          {entry.data.h1}
        </h1>
      </header>

      <div class="prose prose-slate max-w-none text-slate-800 text-sm sm:text-base leading-relaxed space-y-4">
        <Content />
      </div>

      <!-- Previous & Next Term Navigation -->
      <nav class="my-8 pt-6 border-t border-slate-200" aria-label="百科翻页导航">
        <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">知识导航 / 上下一个术语</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href={`/glossary/${prevTerm.slug}/`} class="group p-4 bg-slate-50 hover:bg-blue-50/60 border border-slate-200 hover:border-blue-300 rounded-xl transition-all flex flex-col justify-between">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-blue-600 mb-1">
              <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
              <span>上一个术语</span>
            </div>
            <div class="text-sm font-bold text-slate-800 group-hover:text-blue-600 line-clamp-1">
              {prevTerm.data.h1}
            </div>
          </a>

          <a href={`/glossary/${nextTerm.slug}/`} class="group p-4 bg-slate-50 hover:bg-blue-50/60 border border-slate-200 hover:border-blue-300 rounded-xl transition-all flex flex-col justify-between text-right">
            <div class="flex items-center justify-end gap-1.5 text-xs font-semibold text-blue-600 mb-1">
              <span>下一个术语</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </div>
            <div class="text-sm font-bold text-slate-800 group-hover:text-blue-600 line-clamp-1">
              {nextTerm.data.h1}
            </div>
          </a>
        </div>
      </nav>

      <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between">
        <a href="/glossary/" class="btn-brand-secondary text-xs">← 术语百科全览</a>
        <a href="/ranking/overall/" class="btn-brand-primary text-xs">查看2026综合排行榜 →</a>
      </div>
    </article>
  </div>
</BaseLayout>
