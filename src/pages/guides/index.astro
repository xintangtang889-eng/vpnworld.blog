---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const guides = await getCollection('guides');
guides.sort((a, b) => a.slug.localeCompare(b.slug));

const title = '翻墙客户端与节点配置教程中心 (共30篇) - Clash / Sing-box / Surge 全平台实操 | VPNWorld';
const description = '2026最全科学上网翻墙客户端安装与节点配置教程中心。收录 30 篇涵盖 Windows、macOS、iOS、Android、软路由与游戏主机的保姆级图文教程。';
const keywords = '翻墙教程, 梯子配置, Clash教程, Sing-box教程, Shadowrocket设置, 软路由翻墙, 苹果翻墙教程';

const breadcrumbItems = [{ name: '使用教程中心' }];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <div class="container-custom py-6">
    <Breadcrumb items={breadcrumbItems} />

    <section class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-3">翻墙客户端与节点配置使用教程中心</h1>
      <p class="text-xs sm:text-sm text-slate-600 max-w-3xl leading-relaxed mb-6">
        汇集 30 篇针对全平台（Windows / Mac / iPhone / Android / 软路由 / 电视与游戏机）的保姆级实操指南。从客户端下载、机场订阅一键导入，到 Tun 虚拟网卡接管、分流策略组与防封锁调优，彻底化解网络门槛。
      </p>

      <!-- Quick Platform Filter Pills -->
      <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-xs flex flex-wrap items-center gap-2 text-xs">
        <strong class="text-blue-600 mr-1">平台快速定位：</strong>
        <a href="/guides/windows/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded">Windows 电脑</a>
        <a href="/guides/macos/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded">macOS 苹果电脑</a>
        <a href="/guides/ios/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded">iOS 苹果手机</a>
        <a href="/guides/android/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded">Android 安卓手机</a>
        <a href="/guides/router-openwrt/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded">软路由 OpenWrt</a>
        <a href="/guides/apple-tv/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded">Apple TV</a>
        <a href="/guides/game-console-proxy/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded">主机 PS5/Switch</a>
        <a href="/guides/chatgpt-unblock/" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded">ChatGPT 解锁</a>
      </div>
    </section>

    <!-- 30 Guides Grid -->
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-slate-900 m-0">全部实战教程清单 (共 30 篇)</h2>
      <span class="text-xs text-slate-400">已通过 2026 最新内核兼容性验证</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {guides.map((guide, idx) => (
        <article class="card-custom p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="badge-brand text-[10px]">{guide.data.platform || '通用客户端'}</span>
              <span class="text-[11px] text-slate-400">教程 #{idx + 1}</span>
            </div>

            <h3 class="text-base font-bold text-slate-900 line-clamp-2 mb-2 hover:text-blue-600 leading-snug">
              <a href={`/guides/${guide.slug}/`}>{guide.data.h1}</a>
            </h3>

            <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4">
              {guide.data.description}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100">
            <a href={`/guides/${guide.slug}/`} class="btn-brand-secondary text-xs w-full block text-center py-1.5">
              阅读完整教程 →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
